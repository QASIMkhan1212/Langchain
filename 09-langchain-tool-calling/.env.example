# Pick one. groq is the default if LLM_PROVIDER is unset.
LLM_PROVIDER=groq

# groq: free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=

# gemini: free tier, get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# litellm: only needed if LLM_PROVIDER=litellm -- reuses the keys above
LITELLM_MODEL=groq/llama-3.3-70b-versatile
